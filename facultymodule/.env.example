# Copy this file to .env and fill it in. Never commit .env.

# MongoDB Atlas > Connect > Drivers > copy the connection string, put your DB user's password in it
MONGODB_URI=mongodb+srv://idsc_app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=idsc

PORT=3000

# Set both to 1 once the site is served over HTTPS (Nginx/Caddy/hosting provider)
COOKIE_SECURE=0
TRUST_PROXY=0

# Time-in after this time is marked Late
LATE_AFTER=08:15
TZ=Asia/Manila
